<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — KUETRS Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="admin-body">

    <!-- Sidebar -->
    <nav id="admin-sidebar" class="admin-sidebar">
        <div class="sidebar-brand">
            <span class="brand-text">KUET<span class="brand-accent">RS</span></span>
            <button id="sidebar-toggle" class="sidebar-toggle-btn" aria-label="Toggle sidebar">
                <i class="bi bi-layout-sidebar-reverse"></i>
            </button>
        </div>
        <ul class="sidebar-nav">
            <li class="nav-label">MAIN</li>
            <li>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                </a>
            </li>
            <li class="nav-label">CONTENT</li>
            <li>
                <a asp-area="Admin" asp-controller="Team" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Team" ? "active" : "")">
                    <i class="bi bi-people-fill"></i><span>Team Members</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Activity" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activity" ? "active" : "")">
                    <i class="bi bi-lightning-fill"></i><span>Activities</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Event" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Event" ? "active" : "")">
                    <i class="bi bi-calendar-event-fill"></i><span>Events</span>
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Gallery" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Gallery" ? "active" : "")">
                    <i class="bi bi-images"></i><span>Gallery</span>
                </a>
            </li>
            <li class="nav-label">COMMUNICATIONS</li>
            <li>
                <a asp-area="Admin" asp-controller="Messages" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Messages" ? "active" : "")">
                    <i class="bi bi-envelope-fill"></i><span>Messages</span>
                    @if (ViewBag.UnreadCount != null && (int)ViewBag.UnreadCount > 0)
                    {
                        <span class="badge bg-danger ms-auto">@ViewBag.UnreadCount</span>
                    }
                </a>
            </li>
            <li class="nav-label">SETTINGS</li>
            <li>
                <a asp-area="Admin" asp-controller="Settings" asp-action="Edit" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="bi bi-gear-fill"></i><span>Site Settings</span>
                </a>
            </li>
        </ul>
        <div class="sidebar-footer">
            <a href="/" target="_blank" class="sidebar-link">
                <i class="bi bi-globe2"></i><span>View Site</span>
            </a>
        </div>
    </nav>

    <!-- Main Content Area -->
    <div id="admin-main" class="admin-main">
        <!-- Topbar -->
        <header class="admin-topbar">
            <div class="topbar-left">
                <h5 class="page-title mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="topbar-right">
                <div class="dropdown">
                    <button class="btn admin-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <div class="admin-avatar"><i class="bi bi-person-fill"></i></div>
                        <span>Admin</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/"><i class="bi bi-globe2 me-2"></i>View Site</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="admin-content">
            <!-- Toast Notifications -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

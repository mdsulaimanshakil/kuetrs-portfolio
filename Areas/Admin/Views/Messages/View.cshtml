@model KUETResearchSociety.Models.ContactMessage
@{
    ViewData["Title"] = "View Message";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <h5 class="admin-card-title mb-0"><i class="bi bi-envelope-open me-2"></i>Message Details</h5>
                <a asp-area="Admin" asp-controller="Messages" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
            </div>
            <div class="admin-card-body">
                <div class="message-detail">
                    <div class="message-meta">
                        <div class="meta-row">
                            <span class="meta-label">From:</span>
                            <span class="meta-value">@Model.Name</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Email:</span>
                            <a href="mailto:@Model.Email" class="meta-value">@Model.Email</a>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Subject))
                        {
                            <div class="meta-row">
                                <span class="meta-label">Subject:</span>
                                <span class="meta-value">@Model.Subject</span>
                            </div>
                        }
                        <div class="meta-row">
                            <span class="meta-label">Date:</span>
                            <span class="meta-value">@Model.CreatedAt.ToString("MMMM dd, yyyy — HH:mm")</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Status:</span>
                            <span class="badge bg-success">Read</span>
                        </div>
                    </div>
                    <hr style="border-color: var(--admin-border);" />
                    <div class="message-body">
                        <p>@Model.Message</p>
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <a href="mailto:@Model.Email?subject=Re: @Model.Subject" class="btn btn-primary">
                            <i class="bi bi-reply me-1"></i>Reply via Email
                        </a>
                        <button class="btn btn-outline-danger btn-delete" data-id="@Model.Id" data-url="@Url.Action("Delete","Messages", new { area="Admin" })" data-name="this message">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

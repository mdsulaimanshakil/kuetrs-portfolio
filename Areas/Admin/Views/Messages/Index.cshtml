@model List<KUETResearchSociety.Models.ContactMessage>
@{
    ViewData["Title"] = "Messages";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h5 class="admin-card-title mb-0"><i class="bi bi-envelope-fill me-2"></i>Contact Messages</h5>
        <span class="badge bg-danger">@Model.Count(m => !m.IsRead) Unread</span>
    </div>
    <div class="admin-card-body p-0">
        <div class="table-responsive">
            <table class="table admin-table datatable mb-0">
                <thead>
                    <tr>
                        <th>From</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                        <tr class="@(!msg.IsRead ? "unread-row" : "")">
                            <td class="fw-semibold" style="color:var(--admin-text)">@msg.Name</td>
                            <td>@msg.Email</td>
                            <td>@(msg.Subject ?? "(no subject)")</td>
                            <td class="text-muted small">@msg.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                @if (!msg.IsRead)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-dot"></i> Unread</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Read</span>
                                }
                            </td>
                            <td>
                                <div class="action-btns">
                                    <a asp-area="Admin" asp-controller="Messages" asp-action="View" asp-route-id="@msg.Id" class="btn btn-xs btn-outline-primary"><i class="bi bi-eye"></i></a>
                                    <button class="btn btn-xs btn-outline-danger btn-delete" data-id="@msg.Id" data-url="@Url.Action("Delete","Messages", new { area="Admin" })" data-name="message from @msg.Name"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

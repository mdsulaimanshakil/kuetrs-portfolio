@model List<KUETResearchSociety.Models.Event>
@{
    ViewData["Title"] = "Events";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h5 class="admin-card-title mb-0"><i class="bi bi-calendar-event-fill me-2"></i>Events</h5>
        <a asp-area="Admin" asp-controller="Event" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i>Add Event
        </a>
    </div>
    <div class="admin-card-body p-0">
        <div class="table-responsive">
            <table class="table admin-table datatable mb-0">
                <thead>
                    <tr>
                        <th>Banner</th>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(ev.BannerImage))
                                {
                                    <img src="@ev.BannerImage" class="table-thumb" alt="@ev.Title" />
                                }
                                else
                                {
                                    <div class="table-thumb-placeholder"><i class="bi bi-calendar3"></i></div>
                                }
                            </td>
                            <td class="fw-semibold" style="color:var(--admin-text)">@ev.Title</td>
                            <td>
                                <span class="badge @(ev.EventDate >= DateTime.Now ? "bg-success" : "bg-secondary")">
                                    @ev.EventDate.ToString("MMM dd, yyyy")
                                </span>
                            </td>
                            <td>@ev.Venue</td>
                            <td>
                                <div class="action-btns">
                                    <a asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-xs btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                    <button class="btn btn-xs btn-outline-danger btn-delete" data-id="@ev.Id" data-url="@Url.Action("Delete","Event", new { area="Admin" })" data-name="@ev.Title"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

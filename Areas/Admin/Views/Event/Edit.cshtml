@model KUETResearchSociety.Models.Event
@{
    ViewData["Title"] = "Edit Event";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Event</h5>
            </div>
            <div class="admin-card-body">
                <form asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label admin-label">Event Title *</label>
                            <input asp-for="Title" class="form-control admin-input" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EventDate" class="form-label admin-label">Event Date *</label>
                            <input asp-for="EventDate" type="datetime-local" class="form-control admin-input" value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="EventDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Venue" class="form-label admin-label">Venue</label>
                            <input asp-for="Venue" class="form-control admin-input" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label admin-label">Description *</label>
                            <textarea asp-for="Description" class="form-control admin-input" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label admin-label">Banner Image</label>
                            @if (!string.IsNullOrEmpty(Model.BannerImage))
                            {
                                <div class="mb-2">
                                    <img src="@Model.BannerImage" style="height:80px;width:auto;border-radius:6px;" alt="Current banner" />
                                    <p class="text-muted small mt-1">Upload new to replace.</p>
                                </div>
                            }
                            <input type="file" name="bannerFile" class="form-control admin-input" accept="image/*" />
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Update Event</button>
                        <a asp-area="Admin" asp-controller="Event" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

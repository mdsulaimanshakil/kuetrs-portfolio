@model KUETResearchSociety.Models.TeamMember
@{
    ViewData["Title"] = "Edit Team Member";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Team Member</h5>
            </div>
            <div class="admin-card-body">
                <form asp-area="Admin" asp-controller="Team" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label admin-label">Full Name *</label>
                            <input asp-for="Name" class="form-control admin-input" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label admin-label">Designation *</label>
                            <input asp-for="Designation" class="form-control admin-input" />
                            <span asp-validation-for="Designation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label admin-label">Department</label>
                            <input asp-for="Department" class="form-control admin-input" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Batch" class="form-label admin-label">Batch</label>
                            <input asp-for="Batch" class="form-control admin-input" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="DisplayOrder" class="form-label admin-label">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="form-control admin-input" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Facebook" class="form-label admin-label">Facebook URL</label>
                            <input asp-for="Facebook" class="form-control admin-input" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LinkedIn" class="form-label admin-label">LinkedIn URL</label>
                            <input asp-for="LinkedIn" class="form-control admin-input" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Bio" class="form-label admin-label">Bio</label>
                            <textarea asp-for="Bio" class="form-control admin-input" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label admin-label">Profile Photo</label>
                            @if (!string.IsNullOrEmpty(Model.Photo))
                            {
                                <div class="mb-2">
                                    <img src="@Model.Photo" alt="Current photo" style="height:100px;border-radius:50%;border:2px solid #64ffda;" />
                                    <p class="text-muted small mt-1">Current photo. Upload a new one to replace.</p>
                                </div>
                            }
                            <input type="file" name="photoFile" class="form-control admin-input" accept="image/*" />
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Update Member</button>
                        <a asp-area="Admin" asp-controller="Team" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}

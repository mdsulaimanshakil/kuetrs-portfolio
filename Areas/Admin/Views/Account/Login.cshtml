@model KUETResearchSociety.ViewModels.Admin.LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — KUET Research Society</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        body { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #0d1117; }
        .login-card { background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 2.5rem; width: 100%; max-width: 420px; box-shadow: 0 16px 64px rgba(0,0,0,0.5); }
        .login-logo { font-size: 2rem; font-weight: 800; color: #ccd6f6; margin-bottom: 0.25rem; }
        .login-logo span { color: #64ffda; }
        .login-subtitle { color: #8892b0; font-size: 0.9rem; margin-bottom: 2rem; }
        .form-control { background: #0d1117; border-color: #30363d; color: #ccd6f6; }
        .form-control:focus { background: #161b22; border-color: #64ffda; box-shadow: 0 0 0 0.2rem rgba(100,255,218,0.15); color: #ccd6f6; }
        .form-label { color: #8892b0; font-size: 0.875rem; }
        .btn-login { background: #64ffda; color: #0d1117; font-weight: 700; border: none; width: 100%; padding: 0.75rem; border-radius: 6px; font-size: 1rem; transition: all 0.3s; }
        .btn-login:hover { background: transparent; color: #64ffda; border: 1px solid #64ffda; }
        .back-link { color: #8892b0; text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 6px; }
        .back-link:hover { color: #64ffda; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="login-logo">KUET<span>RS</span></div>
            <div class="login-subtitle">Admin Panel — Secure Login</div>
        </div>

        <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="font-size:0.875rem;"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="admin@kuetrs.org" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label" style="color:#8892b0; font-size:0.875rem;">Remember me for 8 hours</label>
            </div>

            <button type="submit" class="btn btn-login">Sign In to Dashboard</button>
        </form>

        <div class="text-center mt-3">
            <a href="/" class="back-link">← Back to website</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
